# Ragrails API runtime environment.
#
# Copy this file to docker/env/api.env and fill in the providers you use:
#
#   cp docker/env/api.env.example docker/env/api.env

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
VOYAGE_API_KEY=

VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_COLLECTION=rag_chunks

# Pinecone example:
# VECTOR_DB_PROVIDER=pinecone
# VECTOR_DB_URL=
# VECTOR_DB_COLLECTION=rag-chunks
# PINECONE_API_KEY=
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_NAMESPACE=

# Weaviate example:
# VECTOR_DB_PROVIDER=weaviate
# VECTOR_DB_URL=http://weaviate:8080
# VECTOR_DB_COLLECTION=RagChunks
# WEAVIATE_API_KEY=
# WEAVIATE_GRPC_HOST=weaviate
# WEAVIATE_GRPC_PORT=50051
