OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
PINECONE_API_KEY=
WEAVIATE_API_KEY=

# Optional vector database defaults. Qdrant is the first built-in adapter.
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=rag_chunks

# Pinecone example:
# VECTOR_DB_PROVIDER=pinecone
# VECTOR_DB_URL=
# VECTOR_DB_COLLECTION=rag-chunks
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# PINECONE_NAMESPACE=

# Weaviate example:
# VECTOR_DB_PROVIDER=weaviate
# VECTOR_DB_URL=http://localhost:8080
# VECTOR_DB_COLLECTION=RagChunks
# WEAVIATE_GRPC_HOST=localhost
# WEAVIATE_GRPC_PORT=50051
